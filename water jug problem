# Water Jug Problem using Recursion and Memoization
 
from collections import defaultdict

# Capacities of the two jugs and the desired goal amount
jug1, jug2, aim = 4, 3, 2

# Dictionary to store visited states
visited = defaultdict(lambda: False)

# Recursive function to solve the problem
def waterJugSolver(amt1, amt2):
    # Goal condition
    if (amt1 == aim and amt2 == 0) or (amt2 == aim and amt1 == 0):
        print(amt1, amt2)
        return True

    # If state not visited yet
    if visited[(amt1, amt2)] == False:
        print(amt1, amt2)
        visited[(amt1, amt2)] = True

        # Check all 6 possible moves
        return (waterJugSolver(0, amt2) or                   # Empty jug1
                waterJugSolver(amt1, 0) or                   # Empty jug2
                waterJugSolver(jug1, amt2) or                # Fill jug1
                waterJugSolver(amt1, jug2) or                # Fill jug2
                waterJugSolver(amt1 + min(amt2, (jug1 - amt1)),
                               amt2 - min(amt2, (jug1 - amt1))) or  # Pour jug2 → jug1
                waterJugSolver(amt1 - min(amt1, (jug2 - amt2)),
                               amt2 + min(amt1, (jug2 - amt2))))    # Pour jug1 → jug2
    else:
        return False

# Main program
print("Steps:")
waterJugSolver(0, 0)
